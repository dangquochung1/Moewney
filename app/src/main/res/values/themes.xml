<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Meowney" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/meowney_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Meowney.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/meowney_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Meowney</item>
    </style>
</resources>
