      // Width 14 is a wide enough arc to catch two enemies standing shoulder to
      // shoulder at 16px each, which is what makes it the answer to a mouse pack.
      "damage": 12, "reach": 26, "width": 14,
      "windupSteps": 8, "activeSteps": 4, "recoverSteps": 16,
      "knockback": 80, "rootSteps": 6
    },
    {
