      "sprite": "slimes/slimespike/idle", "cell": 64,
      // The cove's floor mob, and the one that reads as ordinary so the other
      // two read as strange. It swings rather than bumping, which is what the
      // spike burst in its attack sheet is drawn as.
      "maxHp": 44, "contactDamage": 5, "attackDamage": 9, "moveSpeed": 44,
      "brain": "chaser", "aggroRange": 110, "attackRange": 16,
      "windupSteps": 18, "activeSteps": 8, "recoverSteps": 18, "cooldownSteps": 34,
      "knockbackResist": 0.15, "hurtInvulnSteps": 10,
      "armour": 1, "attackSpeed": 1.15,
