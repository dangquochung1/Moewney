      "brain": "hopper", "aggroRange": 90, "attackRange": 0,
      // The long cooldown is the whole lesson: it telegraphs, it lands, and
      // there is half a second afterwards in which it cannot hurt you.
      "windupSteps": 20, "activeSteps": 10, "recoverSteps": 20, "cooldownSteps": 30,
      "knockbackResist": 0.10, "hurtInvulnSteps": 10,
      "lootTable": "trash_f1", "goldMin": 2, "goldMax": 5
    },
    {
